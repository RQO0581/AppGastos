<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- La versión que muestra la pantalla Más: la fecha y hora de la última publicación en pruebas.
       La escribe scripts/publicar-pruebas.ps1 en version-pruebas.txt. Producción compila con ese mismo
       archivo, así que muestra la versión que se aprobó en pruebas, no la hora de su propia compilación.
       Sin el archivo, la compilación falla: es mejor no publicar que mostrar una versión falsa. -->
  <Target Name="GenerarVersionCompilada" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <ArchivoVersionPruebas>$(MSBuildProjectDirectory)/version-pruebas.txt</ArchivoVersionPruebas>
    </PropertyGroup>
    <Error Condition="!Exists('$(ArchivoVersionPruebas)')" Text="Falta version-pruebas.txt: lo escribe scripts/publicar-pruebas.ps1." />
    <PropertyGroup>
      <VersionCompilada>$([System.IO.File]::ReadAllText('$(ArchivoVersionPruebas)').Trim())</VersionCompilada>
      <ArchivoVersionCompilada>$(IntermediateOutputPath)VersionCompilada.g.cs</ArchivoVersionCompilada>
    </PropertyGroup>
    <WriteLinesToFile File="$(ArchivoVersionCompilada)" Overwrite="true"
                      Lines="namespace AppGastos.Servicios%3B public static class VersionCompilada { public const string Valor = &quot;$(VersionCompilada)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(ArchivoVersionCompilada)" />
    </ItemGroup>
  </Target>

</Project>
