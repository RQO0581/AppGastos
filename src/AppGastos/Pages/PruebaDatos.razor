@page "/prueba-datos"
@using System.Globalization
@using AppGastos.Modelos
@inject Almacen Almacen

<PageTitle>Prueba de datos</PageTitle>

<h1>Prueba de datos</h1>

<p>Guarda datos de ejemplo en el teléfono. Deben seguir aquí al cerrar y abrir la app.</p>

<h2>Transacciones: <span id="total-cantidad">@transacciones.Length</span></h2>
<p>Suma: <strong id="total-suma">@Monto(transacciones.Sum(t => t.Monto))</strong></p>

<button class="boton" id="anadir" @onclick="AnadirEjemplos">Añadir 3 de ejemplo</button>
<button class="boton" id="borrar-enero" @onclick="BorrarEnero">Borrar del 1/1/2026 al 1/31/2026</button>

<ul class="lista" id="lista">
    @foreach (var transaccion in transacciones)
    {
        <li class="lista-fila">
            <span>
                <strong>@transaccion.Fecha.ToString("M/d/yyyy", CultureInfo.InvariantCulture) · @Monto(transaccion.Monto)</strong><br />
                @transaccion.CuentaOrigen → @transaccion.CuentaGasto (@transaccion.MetodoPago)
            </span>
            <span class="lista-acciones">
                <button class="boton" @onclick="() => SumarUno(transaccion)">+1</button>
                <button class="boton" @onclick="() => Borrar(transaccion)">Borrar</button>
            </span>
        </li>
    }
</ul>

<h2>Cuentas</h2>
<ul>
    <li>Cuentas de origen: <span id="cuentas-origen">@cuentasOrigen.Length</span></li>
    <li>Cuentas de gasto: <span id="cuentas-gasto">@cuentasGasto.Length</span></li>
</ul>
<button class="boton" id="guardar-cuentas" @onclick="GuardarCuentas">Guardar cuentas de ejemplo</button>

<h2>Correo</h2>
<label class="etiqueta" for="correo">Correo guardado</label>
<input class="campo" id="correo" type="email" inputmode="email" autocomplete="off" placeholder="nombre@ejemplo.com" @bind="correo" @bind:event="oninput" />
<button class="boton" id="guardar-correo" disabled="@string.IsNullOrWhiteSpace(correo)" @onclick="GuardarCorreo">Guardar correo</button>

<h2>Estado</h2>
<ul id="estado">
    <li>Protegido contra borrado automático: @(persistente is null ? "-" : persistente.Value ? "sí" : "no")</li>
    <li>Última acción: @estado</li>
</ul>

@code {
    private Transaccion[] transacciones = [];
    private CuentaOrigen[] cuentasOrigen = [];
    private CuentaGasto[] cuentasGasto = [];
    private string correo = "";
    private bool? persistente;
    private string estado = "-";

    // Los montos no usan el idioma del teléfono: en algunos idiomas 104.24 se vería como 104,24.
    private static string Monto(decimal monto) => monto.ToString("N2", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await Intentar("Datos cargados", async () =>
        {
            persistente = await Almacen.PedirPersistenciaAsync();
            correo = await Almacen.ObtenerCorreoAsync() ?? "";
        });
    }

    private Task AnadirEjemplos() => Intentar("Se añadieron 3 transacciones", async () =>
    {
        await Almacen.GuardarTransaccionAsync(Nueva(new DateOnly(2026, 1, 15), 104.24m, MetodoPago.TarjetaDebito, "Banco-Ejemplo", "Telefonos"));
        await Almacen.GuardarTransaccionAsync(Nueva(new DateOnly(2026, 2, 28), 0.10m, MetodoPago.Efectivo, "Efectivo", "Comida"));
        await Almacen.GuardarTransaccionAsync(Nueva(new DateOnly(2026, 12, 31), 1250.50m, MetodoPago.AthMovil, "Banco-Ejemplo", "Comida"));
    });

    private async Task BorrarEnero()
    {
        var borradas = 0;
        var mensaje = () => $"Transacciones de enero borradas: {borradas}";
        await Intentar("", async () =>
            borradas = await Almacen.BorrarTransaccionesPorRangoAsync(new DateOnly(2026, 1, 1), new DateOnly(2026, 1, 31)));
        if (!estado.StartsWith("error"))
        {
            estado = mensaje();
        }
    }

    private Task SumarUno(Transaccion transaccion) => Intentar("Transacción editada", async () =>
    {
        var guardada = await Almacen.ObtenerTransaccionAsync(transaccion.Id);
        guardada!.Monto += 1;
        await Almacen.GuardarTransaccionAsync(guardada);
    });

    private Task Borrar(Transaccion transaccion) => Intentar("Transacción borrada", async () =>
        await Almacen.BorrarTransaccionAsync(transaccion.Id));

    private Task GuardarCuentas() => Intentar("Cuentas guardadas", async () =>
    {
        await Almacen.ReemplazarCatalogoAsync(
        [
            new CuentaOrigen { Nombre = "Efectivo", Tipo = TipoCuentaOrigen.Efectivo },
            new CuentaOrigen { Nombre = "Banco-Ejemplo", Tipo = TipoCuentaOrigen.Banco },
            new CuentaOrigen { Nombre = "Tarjeta-Ejemplo", Tipo = TipoCuentaOrigen.TarjetaCredito },
        ],
        [
            new CuentaGasto { Nombre = "Comida" },
            new CuentaGasto { Nombre = "Telefonos" },
        ]);
    });

    private Task GuardarCorreo() => Intentar("Correo guardado", async () =>
        await Almacen.GuardarCorreoAsync(correo.Trim()));

    private static Transaccion Nueva(DateOnly fecha, decimal monto, MetodoPago metodo, string origen, string gasto) => new()
    {
        Id = Guid.NewGuid(),
        Fecha = fecha,
        Monto = monto,
        MetodoPago = metodo,
        CuentaOrigen = origen,
        CuentaGasto = gasto,
    };

    private async Task Intentar(string mensaje, Func<Task> accion)
    {
        try
        {
            await accion();
            transacciones = await Almacen.ListarTransaccionesAsync();
            cuentasOrigen = await Almacen.ListarCuentasOrigenAsync();
            cuentasGasto = await Almacen.ListarCuentasGastoAsync();
            estado = mensaje;
        }
        catch (Exception error)
        {
            estado = $"error: {error.Message}";
        }
    }
}
